# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=shopfast
DB_PASSWORD=shopfast_secret
DB_NAME=shopfast_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# JWT Authentication
JWT_ACCESS_SECRET=shopfast_super_secret_access_jwt_key_2026_dev
JWT_REFRESH_SECRET=shopfast_super_secret_refresh_jwt_key_2026_dev
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Throttler / Rate Limit
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# AI Support Agent (Google Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=mock

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost:3000
